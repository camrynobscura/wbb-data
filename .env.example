# Supabase Postgres connection string (Session pooler — IPv4, port 5432).
# Copy this file to `.env` and paste the real value from the Supabase dashboard
# (Project Settings → Database → Connection string → "Session pooler").
# The real `.env` is git-ignored.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional — change notifications for the scheduled refresh (scripts/refresh-current.ts).
# Set whichever you use; Telegram wins if both are set; if neither is set the refresh
# just logs the change instead of sending it.
#   Telegram: an Apprise-style URL — tgram://<bot_token>/<chat_id>
#   Discord:  an incoming webhook URL
TELEGRAM_URL=tgram://BOT_TOKEN/CHAT_ID
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
