# Supabase Postgres connection string (Session pooler — IPv4, port 5432).
# Copy this file to `.env` and paste the real value from the Supabase dashboard
# (Project Settings → Database → Connection string → "Session pooler").
# The real `.env` is git-ignored.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional — Telegram change notifications for the scheduled refresh
# (scripts/refresh-current.ts), as an Apprise-style URL: tgram://<bot_token>/<chat_id>.
# If it's not set, the refresh just logs the change instead of sending it.
TELEGRAM_URL=tgram://BOT_TOKEN/CHAT_ID
