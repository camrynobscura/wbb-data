{
  "name": "wnba-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private data layer for the wnba-arc visualizer — ESPN adapter + Postgres (Supabase) + derived stats.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/api/server.ts",
    "serve:watch": "tsx watch src/api/server.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "tsx": "^4.23.12"
  }
}
