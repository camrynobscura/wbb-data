{
  "name": "wbb-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The data layer for Arc (wbb-arc): an ESPN adapter, Postgres (Supabase) and derived stats.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/test-db.ts",
    "format": "prettier --write src scripts tsconfig.json vitest.config.ts vitest.db.config.ts .github .oxlintrc.json",
    "format:check": "prettier --check src scripts tsconfig.json vitest.config.ts vitest.db.config.ts .github .oxlintrc.json",
    "serve": "tsx src/api/server.ts",
    "serve:watch": "tsx watch src/api/server.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "tsx": "^4.23.12"
  }
}
